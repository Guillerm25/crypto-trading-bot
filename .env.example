# Coinbase Advanced Trade API (for market data in paper/live mode)
COINBASE_API_KEY=your-api-key
COINBASE_API_SECRET=your-api-secret

# Coinbase Exchange Sandbox (for demo wallet trading)
# Create sandbox credentials at: https://public.sandbox.exchange.coinbase.com
COINBASE_SANDBOX_API_KEY=your-sandbox-api-key
COINBASE_SANDBOX_API_SECRET=your-sandbox-api-secret
COINBASE_SANDBOX_PASSPHRASE=your-sandbox-passphrase

# Trading configuration
TRADING_MODE=paper          # paper | sandbox | live
DEFAULT_QUOTE_CURRENCY=USDT
PAPER_TRADING_BALANCE=10000 # Initial paper trading balance in quote currency
