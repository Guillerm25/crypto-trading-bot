# Bybit API (for market data and live trading)
BYBIT_API_KEY=
BYBIT_API_SECRET=

# Bybit Testnet (for demo wallet trading)
# Create testnet credentials at: https://testnet.bybit.com
BYBIT_TESTNET_API_KEY=
BYBIT_TESTNET_API_SECRET=

# Bybit hostname (use bybit.eu for Europe, bybit.com for global)
BYBIT_HOSTNAME=bybit.com

# Set to true if you created API keys from Demo Trading (not Testnet)
# Demo Trading: uses your main Bybit account in demo mode
# Testnet: separate accounts created at testnet.bybit.com
BYBIT_DEMO_TRADING=false

# Trading configuration
# Options: paper (local simulation), sandbox (Bybit testnet), live (real money)
TRADING_MODE=paper
DEFAULT_QUOTE_CURRENCY=USDT
# Initial paper trading balance in quote currency
PAPER_TRADING_BALANCE=10000
