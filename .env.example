# Bybit API (for market data and live trading)
BYBIT_API_KEY=your-api-key
BYBIT_API_SECRET=your-api-secret

# Bybit Testnet (for demo wallet trading)
# Create testnet credentials at: https://testnet.bybit.com
BYBIT_TESTNET_API_KEY=your-testnet-api-key
BYBIT_TESTNET_API_SECRET=your-testnet-api-secret

# Trading configuration
TRADING_MODE=paper          # paper | sandbox | live
DEFAULT_QUOTE_CURRENCY=USDT
PAPER_TRADING_BALANCE=10000 # Initial paper trading balance in quote currency
